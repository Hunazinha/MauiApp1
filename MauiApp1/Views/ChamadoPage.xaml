<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.ChamadoPage"
             Title="Chamados"
             xmlns:viewmodels="clr-namespace:MauiApp1.ViewModels">
    <ContentPage.BindingContext>
        <viewmodels:ChamadosViewModel />
    </ContentPage.BindingContext>

    <TabView>
        <TabViewItem Text="Pendentes">
            <CollectionView ItemsSource="{Binding Pendentes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame>
                            <StackLayout>
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                <Label Text="{Binding Descricao}" />
                                <Label Text="{Binding Area}" />
                                <Label Text="{Binding DataCriacao, StringFormat='{0:dd/MM/yyyy}'}" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </TabViewItem>

        <TabViewItem Text="Em Andamento">
            <CollectionView ItemsSource="{Binding EmAndamento}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame>
                            <StackLayout>
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                <Label Text="{Binding Descricao}" />
                                <Label Text="{Binding Area}" />
                                <Label Text="{Binding DataCriacao, StringFormat='{0:dd/MM/yyyy}'}" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </TabViewItem>

        <TabViewItem Text="Finalizados">
            <CollectionView ItemsSource="{Binding Finalizados}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame>
                            <StackLayout>
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                <Label Text="{Binding Descricao}" />
                                <Label Text="{Binding Area}" />
                                <Label Text="{Binding DataCriacao, StringFormat='{0:dd/MM/yyyy}'}" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </TabViewItem>
    </TabView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Novo Chamado" Command="{Binding NavigateToNovoChamadoCommand}" />
    </ContentPage.ToolbarItems>
</ContentPage>