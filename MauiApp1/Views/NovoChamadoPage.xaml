<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.NovoChamadoPage"
             Title="Novo Chamado"
             xmlns:viewmodels="clr-namespace:MauiApp1.ViewModels">
    <ContentPage.BindingContext>
        <viewmodels:NovoChamadoViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <StackLayout Padding="20">
            <Label Text="Título" />
            <Entry Text="{Binding Titulo}" />

            <Label Text="Descrição" />
            <Editor Text="{Binding Descricao}" HeightRequest="100" />

            <Label Text="Área" />
            <Picker ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" />

            <Button Text="Criar Chamado" Command="{Binding CriarChamadoCommand}" Margin="0,20,0,0" />
        </StackLayout>
    </ScrollView>
</ContentPage>